{
  "schemaVersion": "1.0",
  "projectId": "11111111-1111-4111-8111-111111111111",
  "name": "示例本地 Web 项目",
  "group": "开发项目",
  "description": "虚构配置示例；源码与停止脚本需绑定，不能直接视为可启动。",
  "source": {
    "kind": "provided",
    "identity": "example-source-v1"
  },
  "requirements": {
    "node-runtime": {
      "component": "node",
      "location": "windows",
      "semantics": "npm",
      "range": "^22.19.0",
      "preferredVersion": "22.19.0",
      "required": true,
      "stages": [
        "prepare",
        "run"
      ],
      "architecture": "amd64",
      "capabilities": [],
      "evidence": {
        "kind": "declaration",
        "reference": "example:runtime-profile"
      }
    }
  },
  "files": {
    "server-entry": {
      "availability": "external",
      "path": {
        "binding": "source",
        "relativePath": "server.mjs"
      },
      "required": true,
      "role": "source"
    },
    "stop-entry": {
      "availability": "external",
      "path": {
        "binding": "source",
        "relativePath": "scripts/stop.mjs"
      },
      "required": true,
      "role": "script"
    }
  },
  "units": {
    "database": {
      "resourceId": "22222222-2222-4222-8222-222222222222",
      "label": "外部数据库",
      "dependsOn": [],
      "requirementIds": [],
      "kind": "external",
      "control": "reference",
      "binding": "database",
      "readiness": {
        "kind": "adapter",
        "adapterId": "database-readonly",
        "timeoutSeconds": 60
      }
    },
    "api": {
      "resourceId": "33333333-3333-4333-8333-333333333333",
      "label": "示例 API",
      "dependsOn": [
        "database"
      ],
      "requirementIds": [
        "node-runtime"
      ],
      "kind": "process",
      "control": "managed",
      "start": {
        "executable": {
          "kind": "runtime",
          "requirementId": "node-runtime",
          "relativePath": "node.exe"
        },
        "args": [
          "${file:server-entry}"
        ],
        "cwd": {
          "binding": "source",
          "relativePath": "."
        },
        "envBindings": {
          "DATABASE_URL": "database-secret"
        }
      },
      "readiness": {
        "kind": "tcp",
        "host": "127.0.0.1",
        "port": 47831,
        "timeoutSeconds": 60
      },
      "stop": {
        "kind": "command",
        "command": {
          "executable": {
            "kind": "runtime",
            "requirementId": "node-runtime",
            "relativePath": "node.exe"
          },
          "args": [
            "${file:stop-entry}"
          ],
          "cwd": {
            "binding": "source",
            "relativePath": "."
          },
          "envBindings": {
            "DATABASE_URL": "database-secret"
          }
        },
        "timeoutSeconds": 30
      }
    }
  },
  "profiles": {
    "development": {
      "label": "本地开发",
      "unitIds": [
        "database",
        "api"
      ],
      "featureIds": []
    }
  }
}
